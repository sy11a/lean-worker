{
  "_comment": "Roles with model chains across plans. The launcher runs the first model with quota headroom and offers the next one only on an `escalate:` line, so the order is the user's priority; Claude comes last. Delete the models of plans the user does not have, then replace {build command} / {test command}. What a model needs beyond the role (for example the pipeline helpers MiniMax-M3 uses) comes from the price book's modelTraits at launch; see <skill-dir>/models.md. Leave \"runtime\" unset: each model then runs in the runtime its provider allows (claude where the plan has an Anthropic-compatible endpoint, else opencode).",
  "defaultProfile": "code",
  "profiles": {
    "read": {
      "model": [
        "minimax-coding-plan/MiniMax-M2.7",
        "zai-coding-plan/glm-5.3-flash",
        "haiku"
      ],
      "effort": "low",
      "tools": [
        "Read",
        "Glob",
        "Grep"
      ],
      "allowedTools": [],
      "maxBudgetUsd": 0.3
    },
    "edit": {
      "model": [
        "minimax-coding-plan/MiniMax-M3",
        "zai-coding-plan/glm-5.3",
        "sonnet"
      ],
      "effort": "low",
      "tools": [
        "Read",
        "Edit",
        "Glob",
        "Grep"
      ],
      "allowedTools": [],
      "maxBudgetUsd": 0.5
    },
    "code": {
      "model": [
        "minimax-coding-plan/MiniMax-M3",
        "zai-coding-plan/glm-5.3",
        "sonnet"
      ],
      "effort": "medium",
      "wrapUpAt": 0.9,
      "tools": [
        "Read",
        "Edit",
        "Write",
        "Glob",
        "Grep",
        "Bash"
      ],
      "allowedTools": [
        "Bash({build command}:*)",
        "Bash({test command}:*)",
        "Bash(git diff:*)",
        "Bash(git status:*)",
        "Bash(git log:*)",
        "Bash(ls:*)",
        "Bash(pwd)"
      ],
      "maxBudgetUsd": 2,
      "_gate_comment": "Optional. Rename \"_gate\" to \"gate\" to run checks after every successful run and re-run the worker with the reports until they pass (SKILL.md, \"Gate\"). Per command: name (unique, ^[a-z][a-z0-9-]{0,31}$) and command (argv) are required; reportFromLastLine finds the report path on the last stdout line; countPath points at the findings array; outputs (files that command writes, excluded only from its own after-gate check) and timeoutMinutes are optional. Shared on the gate itself: trust, env, maxRounds, maxTotalUsd (default 3 x maxBudgetUsd), timeoutMinutes (the default for commands) and feedbackMaxChars (the total for the round). A single-command form (\"command\" plus the same keys on the gate itself) also works.",
      "_gate": {
        "commands": [
          {
            "name": "lint",
            "command": [
              "dotnet",
              "tool",
              "run",
              "sy11a-lint",
              "check",
              "--affected",
              "{target}"
            ],
            "reportFromLastLine": "^sarif: (?<report>.+)$",
            "countPath": "runs[0].results",
            "outputs": [
              "artifacts/gate/lint.sarif"
            ]
          },
          {
            "name": "arch",
            "command": [
              "dotnet",
              "tool",
              "run",
              "sy11a-arch",
              "check",
              "--affected",
              "{project}"
            ],
            "reportFromLastLine": "^sarif: (?<report>.+)$",
            "countPath": "runs[0].results"
          },
          {
            "name": "test",
            "command": [
              "dotnet",
              "tool",
              "run",
              "sy11a-test",
              "check",
              "--affected",
              "--base",
              "origin/master",
              "{test project}"
            ],
            "reportFromLastLine": "^sarif: (?<report>.+)$",
            "countPath": "runs[0].results",
            "timeoutMinutes": 45
          }
        ],
        "trust": [
          "Directory.Build.props",
          "**/.editorconfig"
        ],
        "env": [
          "GATE_*"
        ],
        "maxRounds": 5,
        "timeoutMinutes": 30
      }
    },
    "research": {
      "model": "sonnet",
      "effort": "medium",
      "tools": [
        "Read",
        "WebFetch",
        "WebSearch"
      ],
      "allowedTools": [
        "WebFetch",
        "WebSearch"
      ],
      "maxBudgetUsd": 1
    },
    "review": {
      "model": [
        "zai-coding-plan/glm-5.3",
        "minimax-coding-plan/MiniMax-M3",
        "opus"
      ],
      "effort": "medium",
      "tools": [
        "Read",
        "Glob",
        "Grep",
        "Bash"
      ],
      "allowedTools": [
        "Bash({test command}:*)",
        "Bash(git diff:*)",
        "Bash(git status:*)",
        "Bash(git log:*)",
        "Bash(ls:*)",
        "Bash(pwd)"
      ],
      "maxBudgetUsd": 0.5
    }
  }
}
