{
  "defaultProfile": "code",
  "profiles": {
    "read": {
      "model": "haiku",
      "effort": "low",
      "tools": [
        "Read",
        "Glob",
        "Grep"
      ],
      "allowedTools": [],
      "maxBudgetUsd": 0.5
    },
    "edit": {
      "model": "sonnet",
      "effort": "low",
      "tools": [
        "Read",
        "Edit",
        "Glob",
        "Grep"
      ],
      "allowedTools": [],
      "maxBudgetUsd": 1
    },
    "code": {
      "model": "sonnet",
      "effort": "medium",
      "tools": [
        "Read",
        "Edit",
        "Write",
        "Glob",
        "Grep",
        "Bash"
      ],
      "allowedTools": [
        "Bash({build command}:*)",
        "Bash({test command}:*)",
        "Bash(git diff:*)",
        "Bash(git status:*)",
        "Bash(ls:*)",
        "Bash(cat:*)",
        "Bash(pwd)"
      ],
      "maxBudgetUsd": 3,
      "_gate_comment": "Optional. Rename \"_gate\" to \"gate\" to run a check after every successful run and re-run the worker with its report until it passes (SKILL.md, \"Gate\"). command is argv; reportFromLastLine finds the report path on the last stdout line; countPath points at the findings array. outputs: files the gate writes (excluded only from the after-gate check). trust: extra repo-relative paths or globs whose change by the worker is a violation. env: extra variable names or PREFIX* patterns passed to the gate (the default set is PATH, HOME, locale, DOTNET_*, NUGET_*, NuGetPackageSourceCredentials_*, MSBUILD*). Caps: maxRounds, maxTotalUsd (default 3 x maxBudgetUsd), timeoutMinutes.",
      "_gate": {
        "command": [
          "{gate executable}",
          "{gate argument}"
        ],
        "reportFromLastLine": "^sarif: (?<report>.+)$",
        "countPath": "runs[0].results",
        "outputs": [
          "artifacts/gate/report.sarif"
        ],
        "trust": [
          "Directory.Build.props",
          "**/.editorconfig"
        ],
        "env": [
          "GATE_*"
        ],
        "maxRounds": 5,
        "timeoutMinutes": 30
      }
    },
    "research": {
      "model": "sonnet",
      "effort": "medium",
      "tools": [
        "Read",
        "WebFetch",
        "WebSearch"
      ],
      "allowedTools": [
        "WebFetch",
        "WebSearch"
      ],
      "maxBudgetUsd": 1
    },
    "review": {
      "model": "sonnet",
      "effort": "medium",
      "tools": [
        "Read",
        "Glob",
        "Grep",
        "Bash"
      ],
      "allowedTools": [
        "Bash(git diff:*)",
        "Bash(git log:*)"
      ],
      "maxBudgetUsd": 1
    }
  }
}
