<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 + LatestMajor: builds with any .NET SDK 8+ and runs on the newest runtime installed. -->
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>LeanWorker</AssemblyName>
    <RootNamespace>LeanWorker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LeanWorker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Next to the executable, where the launcher finds them through AppContext.BaseDirectory. -->
    <None Include="prices.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="opencode-plugin.ts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
